/*
  # Core security
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Content Security Policy
  # Allows: same-origin app, Web Worker blobs, Cloudflare Web Analytics, Google AdSense
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googlesyndication.com https://static.cloudflareinsights.com https://*.adtrafficquality.google https://adservice.google.com https://*.googletagservices.com; connect-src 'self' https://cloudflareinsights.com https://*.googlesyndication.com https://*.doubleclick.net https://*.adtrafficquality.google https://adservice.google.com; frame-src *; img-src 'self' data: https://*.doubleclick.net https://*.googlesyndication.com https://*.adtrafficquality.google; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; font-src 'self' data:;
